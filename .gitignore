# Python bytecode (generated when running test_automation.py / the audit scripts)
__pycache__/
*.pyc

# Lint/type-check caches (#388) — created by `ruff check` / `mypy` in the repo root
.ruff_cache/
.mypy_cache/
# uv's project environment for the pinned lint dependencies (pyproject.toml dev group)
.venv/

# Hermes harness scratch - plan-mode output. The tracked .hermes/plugins/ adapter stays.
.hermes/plans/

# P0 eval scratch: cognee/ruff db and A/B driver output (.cognee_ab_run/ has a
# full Ladybug + LanceDB store, ~50 MB, regenerable from ab_driver.py).
.eval-work/
